# ─────────────────────────────────────────────────────────────────────────────
# PneumoVision — DEMO profile.
#
#   npm run gen:secrets -- --write     # writes .env.demo with real secrets
#   npm run dev:demo                   # then start everything
#
# Or copy this file to .env.demo and fill in the four generated values with
# `npm run gen:secrets -- --demo`.
#
# This profile needs no Redis, no S3/MinIO, no field-encryption key and no
# CSRF secret — those code paths are inactive in DEMO_MODE. See
# apps/api/src/config/env.ts for exactly what each profile requires.
# PLACEHOLDERS ONLY. .env.demo itself is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

DEMO_MODE=true
NODE_ENV=development
LOG_LEVEL=info

# ── HTTP ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Vite dev server. The web app proxies /api and /socket.io to the API.
WEB_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# Leave MONGO_URI empty to start an in-process mongodb-memory-server (MongoDB
# 7.0.x, so the native time-series vitals collection works). Point it at a real
# mongod instead if you want the demo data to survive a restart.
MONGO_URI=
MONGO_DB=pneumovision

# ── Inference service ────────────────────────────────────────────────────────
# Started by `npm run dev:demo` via uvicorn on the repo's Python 3.11 venv.
INFERENCE_URL=http://127.0.0.1:8000
# No trained checkpoints exist, so this must stay true.
MOCK_MODE=true
DEFAULT_THETA=0.75
INFERENCE_TIMEOUT_MS=120000

# ── Secrets — generate, never invent ─────────────────────────────────────────
# npm run gen:secrets -- --demo
JWT_PRIVATE_KEY_B64=replace-me-base64-ed25519-private-key-pem
JWT_PUBLIC_KEY_B64=replace-me-base64-ed25519-public-key-pem
INFERENCE_HMAC_SECRET=replace-me-64-hex-chars

# ── Seeded demo accounts ─────────────────────────────────────────────────────
# Both are created on first boot. Passwords must be at least 8 characters.
SEED_ADMIN_EMAIL=admin@pneumovision.local
SEED_ADMIN_PASSWORD=replace-me-demo-password
SEED_CLINICIAN_EMAIL=clinician@pneumovision.local
SEED_CLINICIAN_PASSWORD=replace-me-demo-password

# Where synthetic X-ray PNGs are written (relative to apps/api). Gitignored.
DEMO_DATA_DIR=.demo-data
