**/mimic-cxr-*.csv
**/discharge.csv
**/radiology.csv
**/*.pkl
**/*.pth
**/*.pth.tar
**/*.pt
**/*.ckpt
**/*.safetensors
docs/demo-examples/*.png
medpatch/**/*.log
