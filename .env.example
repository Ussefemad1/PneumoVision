# ─────────────────────────────────────────────────────────────────────────────
# PneumoVision — example environment. Copy to .env and replace every value.
# PLACEHOLDERS ONLY. Never commit a real .env (it is gitignored).
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Public origins ───────────────────────────────────────────────────────────
WEB_ORIGIN=https://localhost
API_BASE_URL=https://localhost/api/v1

# ── API gateway ──────────────────────────────────────────────────────────────
API_PORT=4000
# Access-token lifetime (15 min) and refresh-token lifetime (7 d), per Section 7.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# EdDSA (Ed25519) keypair, PEM, base64-encoded so it survives a single env line.
# Generate:
#   openssl genpkey -algorithm ed25519 -out jwt.key
#   openssl pkey -in jwt.key -pubout -out jwt.pub
#   base64 -w0 jwt.key   /   base64 -w0 jwt.pub
JWT_PRIVATE_KEY_B64=replace-me-base64-ed25519-private-key-pem
JWT_PUBLIC_KEY_B64=replace-me-base64-ed25519-public-key-pem
JWT_ISSUER=pneumovision
JWT_AUDIENCE=pneumovision-web

# AES-256-GCM key for application-level field encryption (note text, demographics).
# Must be 32 bytes, hex-encoded (64 hex chars). Key version is stored beside the
# ciphertext so keys can be rotated without rewriting old records.
FIELD_ENCRYPTION_KEY_HEX=replace-me-64-hex-chars-0000000000000000000000000000000000
FIELD_ENCRYPTION_KEY_VERSION=1

# Double-submit CSRF token secret.
CSRF_SECRET=replace-me-32-byte-hex

# ── MongoDB (replica set: required for transactions + change streams) ────────
MONGO_URI=mongodb://mongo:27017/pneumovision?replicaSet=rs0&directConnection=true
MONGO_DB=pneumovision

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MinIO (S3-compatible object storage for chest X-rays) ────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=pneumovision-cxr
S3_ACCESS_KEY=replace-me-minio-access-key
S3_SECRET_KEY=replace-me-minio-secret-key
S3_FORCE_PATH_STYLE=true
# Presigned GET URLs expire in 5 minutes (Section 7).
S3_PRESIGN_TTL_SECONDS=300

# ── Inference service (internal network only, never exposed via Nginx) ───────
INFERENCE_URL=http://inference:8000
# Shared secret for HMAC-SHA256 request signing over `timestamp + body`.
INFERENCE_HMAC_SECRET=replace-me-32-byte-hex
INFERENCE_HMAC_MAX_SKEW_SECONDS=60
INFERENCE_TIMEOUT_MS=120000

# ── Inference service own config (read by services/inference) ────────────────
# MOCK_MODE=true returns deterministic, schema-valid fake outputs seeded by stay
# id. No trained checkpoints exist in this repo yet, so this must stay true
# until weights are available. See CLAUDE.md § Model status.
MOCK_MODE=true
TORCH_DEVICE=auto
# Root of the training code the inference service imports preprocessing from.
MEDPATCH_ROOT=/app/medpatch
# Checkpoint + normalizer locations (gitignored; mount at runtime).
CHECKPOINT_DIR=/app/checkpoints
NORMALIZER_DIR=/app/medpatch/normalizers
# Confidence-patching threshold θ (MedPatch §3.3). Admin-configurable per model
# version; this is the boot default and matches the training scripts.
DEFAULT_THETA=0.75

# ── Seed / demo ──────────────────────────────────────────────────────────────
# Bootstrap admin for the synthetic demo database. Change before any real use.
SEED_ADMIN_EMAIL=admin@pneumovision.local
SEED_ADMIN_PASSWORD=replace-me-strong-password
