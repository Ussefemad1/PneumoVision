# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*

# VS Code
.vscode/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# MIMIC / medical data
data/*
!data/.gitkeep

# Model checkpoints
checkpoints/*
!checkpoints/.gitkeep

# Experiment results
results/*
!results/.gitkeep

# Large model/data files
*.pth
*.pt
*.ckpt
*.h5
*.tar
*.tar.gz
*.zip
*.7z
*.npy
*.npz

# Logs
*.log
wandb/
outlogs/
errlogs/

# Local tool caches
.cache/

# ── Web platform ──────────────────────────────────────────────────────────────
# Node
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*

# Vite / Playwright
.vite/
playwright-report/
test-results/

# TLS material — generated locally by infra/scripts/gen-certs.sh, never committed
infra/nginx/certs/
*.pem
*.key
*.crt
*.csr

# Local service state (MinIO / Mongo / Redis volumes when bind-mounted)
.docker-data/

# Secrets (the .env rules above already cover .env and .env.*; keep the example)
!.env.example
